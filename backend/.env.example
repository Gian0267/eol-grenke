DATABASE_URL="file:./dev.db"
BACKEND_PORT=3001
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_OFFSET_DAYS=30
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Noleggio Su Misura <info@noleggiosumisura.it>"
FRONTEND_URL=http://localhost:5173

# --- Monitor casella info@ (IMAP in sola lettura, verificato dal pannello Register.it) ---
MONITOR_IMAP_HOST=pop.securemail.pro
MONITOR_IMAP_PORT=993
MONITOR_IMAP_SECURE=true
MONITOR_IMAP_USER=info@noleggiosumisura.it
MONITOR_IMAP_PASSWORD=

# --- Stripe (pagamento con carta) -------------------------------------------
# Senza STRIPE_SECRET_KEY l'app usa il simulatore e nessun incasso e' reale.
# Chiavi di test: sk_test_... / pk_test_...  Chiavi reali: sk_live_... / pk_live_...
# STRIPE_WEBHOOK_SECRET (whsec_...) lo fornisce Stripe quando si crea il webhook:
# senza, il webhook viene rifiutato e la pratica non passa mai a "pagata".
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
